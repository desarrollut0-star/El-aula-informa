# =====================================================================
#  apps/frontend/.env.local.example
#  Comunidad UTHH · El Aula Informa — variables del frontend
#
#  COPIAR A ".env.local" (que NO se sube al repositorio).
#  En Vercel, las mismas variables se cargan en Settings → Environment
#  Variables del proyecto.
#
#  IMPORTANTE: todo lo que empieza con NEXT_PUBLIC_ viaja al navegador
#  y cualquiera puede leerlo. Aquí eso está bien: ninguna de estas tres
#  da acceso a los datos por sí sola. Nunca pongas aquí la llave secreta
#  de Supabase ni el api_secret de Cloudinary.
# =====================================================================


# ---------------------------------------------------------------------
#  SUPABASE — solo para iniciar sesión
#  La llave "publishable" (formato nuevo, sb_publishable_…) sustituye a
#  la vieja "anon key" en formato JWT. Se copia de:
#      Project Settings → API Keys → Publishable key
#
#  Nota: la Data API de este proyecto está DESACTIVADA a propósito, así
#  que esta llave NO sirve para consultar tablas — solo para el login.
#  Todos los datos se piden al Worker, nunca a Supabase directamente.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://rpfrexmdoigwxnstffun.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_PEDIR"


# ---------------------------------------------------------------------
#  API DEL BACKEND (Worker de Cloudflare)
#  En local, wrangler dev levanta en el 8787.
#  En producción, el subdominio api. del dominio propio.
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:8787"


# ---------------------------------------------------------------------
#  CLOUDINARY (solo el nombre de la nube, que es público)
#  Sirve para construir las URL de las imágenes ya subidas. La firma para
#  subir la pide el frontend al Worker; aquí no va ninguna llave.
# ---------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
